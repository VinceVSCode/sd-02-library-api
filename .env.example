# Every setting the API reads, with values for a local run only.
# Copy this file to .env (docker compose reads it). Never commit .env.
# Before any real use, replace every value below.

# PostgreSQL, used by the "db" service and by the API.
POSTGRES_USER=library
POSTGRES_PASSWORD=local-only-password
POSTGRES_DB=library

# Signs the login tokens. At least 32 characters.
JWT_SECRET=replace-this-with-a-long-random-string-before-any-real-use
# How long a login token stays valid, in minutes.
TOKEN_MINUTES=30

# The librarian account that scripts/seed.py creates for the demo.
DEMO_USERNAME=librarian
DEMO_PASSWORD=local-only-demo-password
